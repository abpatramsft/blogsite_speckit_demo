{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blogsite.example.com/schemas/blog-post.schema.json",
  "title": "BlogPost",
  "description": "Schema for blog post metadata",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "author",
    "publishedDate",
    "excerpt",
    "featuredImage",
    "featuredImageAlt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the blog post",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "examples": ["modern-web-development-2026"]
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier (must match markdown filename)",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "examples": ["modern-web-development-2026"]
    },
    "title": {
      "type": "string",
      "description": "Blog post title",
      "minLength": 5,
      "maxLength": 120,
      "examples": ["Modern Web Development in 2026"]
    },
    "author": {
      "type": "string",
      "description": "Author's full name",
      "minLength": 2,
      "maxLength": 50,
      "examples": ["Jane Developer"]
    },
    "publishedDate": {
      "type": "string",
      "description": "Publication date in ISO 8601 format (YYYY-MM-DD)",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "examples": ["2026-01-05"]
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary for previews (100-200 characters)",
      "minLength": 100,
      "maxLength": 200,
      "examples": [
        "Exploring the latest trends and best practices in web development as we move through 2026. From static site generation to modern JavaScript frameworks, discover what's shaping the future."
      ]
    },
    "featuredImage": {
      "type": "string",
      "description": "Path to featured image (relative to /public)",
      "pattern": "^/images/blog/[a-z0-9-]+\\.(jpg|jpeg|png|webp)$",
      "examples": ["/images/blog/modern-web-dev.jpg"]
    },
    "featuredImageAlt": {
      "type": "string",
      "description": "Descriptive alt text for featured image (accessibility)",
      "minLength": 5,
      "maxLength": 150,
      "examples": ["Developer working on a laptop with code on screen"]
    },
    "tags": {
      "type": "array",
      "description": "Post categories/topics (optional)",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20,
        "pattern": "^[a-z0-9-]+$"
      },
      "maxItems": 5,
      "uniqueItems": true,
      "examples": [["web-development", "javascript", "trends"]]
    },
    "readingTimeMinutes": {
      "type": "integer",
      "description": "Estimated reading time in minutes (optional)",
      "minimum": 1,
      "maximum": 60,
      "examples": [8]
    },
    "updatedDate": {
      "type": "string",
      "description": "Last modification date in ISO 8601 format (optional)",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "examples": ["2026-01-06"]
    }
  },
  "additionalProperties": false
}
